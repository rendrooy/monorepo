PORT=3001
DB_URL=
DB_SSL=false
DB_USER=
DB_HOST=localhost
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
DB_SCHEMA=public

# Required only when executing the destructive tenant reset script.
RESET_TARGET_DB=
RESET_TENANT_DATA_CONFIRM=
ALLOW_PRODUCTION_TENANT_RESET=false

# Supabase Storage S3 credentials generated from Storage > Configuration > S3.
# Server-side only. Never expose these values through NEXT_PUBLIC_* variables.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_PRIVATE_BUCKET=homehub-private
SUPABASE_STORAGE_PUBLIC_BUCKET=homehub-public

LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_DIRECTORY=logs
LOG_SQL=true
LOG_SQL_PARAMS=false
SLOW_QUERY_MS=1000
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
PLATFORM_JWT_SECRET=
PLATFORM_JWT_EXPIRES_IN_SECONDS=14400
ALLOW_LEGACY_TENANTLESS_AUTH=true
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
PLATFORM_SCHEDULER_ENABLED=false
PLATFORM_SCHEDULER_POLL_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
TENANT_RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

PLATFORM_ADMIN_USERNAME=SuperAdmin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

NIK_ENCRYPTION_KEY=
NIK_LOOKUP_KEY=
NIK_KEY_VERSION=1
