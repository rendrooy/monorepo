{
  "name": "@monorepo/server",
  "author": "Ives Furtado | @ivesfurtado",
  "version": "1.0.0",
  "description": "",
  "main": "build/main.js",
  "keywords": [],
  "license": "ISC",
  "scripts": {
    "dev": "ts-node-dev --transpile-only src/main.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "db:migrate": "ts-node src/scripts/db-migrate.ts apply",
    "db:migrate:status": "ts-node src/scripts/db-migrate.ts status",
    "db:migrate:validate": "ts-node src/scripts/db-migrate.ts validate",
    "db:reset:tenant-data": "ts-node src/scripts/reset-tenant-data.ts",
    "db:reset:tenant-data:execute": "ts-node src/scripts/reset-tenant-data.ts --execute",
    "platform:bootstrap-admin": "ts-node src/scripts/bootstrap-platform-admin.ts",
    "lint": "eslint .",
    "migrate:nik": "ts-node src/scripts/migrate-nik.ts",
    "test:tenant-isolation": "ts-node src/scripts/verify-tenant-isolation.ts",
    "storage:check": "ts-node src/scripts/check-object-storage.ts",
    "storage:test": "ts-node src/scripts/verify-object-storage.ts",
    "storage:test:tenant": "ts-node src/scripts/verify-file-object-integration.ts",
    "storage:migrate-local": "ts-node src/scripts/migrate-local-files-to-supabase.ts",
    "storage:migrate-local:execute": "ts-node src/scripts/migrate-local-files-to-supabase.ts --execute",
    "subscription:job": "ts-node src/scripts/run-subscription-job.ts",
    "subscription:reconcile": "ts-node src/scripts/reconcile-tenant-subscriptions.ts",
    "test:platform-subscription": "ts-node src/scripts/verify-platform-subscription.ts",
    "test:tenant-admin-readiness": "ts-node src/scripts/verify-tenant-admin-readiness.ts",
    "production:check": "ts-node src/scripts/verify-production-readiness.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@monorepo/types": "workspace:*",
    "cors": "2.8.6",
    "express": "^5.2.1",
    "kysely": "^0.29.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "ts-node-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "10.9.2"
  }
}
